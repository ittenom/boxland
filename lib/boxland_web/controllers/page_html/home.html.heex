<Layouts.app flash={@flash}>
  <section class="grid min-h-[60vh] items-center gap-10 lg:grid-cols-[1fr_24rem]">
    <div class="space-y-6">
      <p class="text-sm font-semibold text-primary">Boxland Designer</p>
      <h1 class="max-w-3xl text-5xl font-semibold tracking-tight">
        Build tile maps, turn them into levels, and publish playable worlds.
      </h1>
      <p class="max-w-2xl text-lg leading-8 text-base-content/70">
        Upload a 32px tileset, paint a map in Mapmaker, add interactive presets in Level Editor,
        test in Sandbox, then publish an immutable live version.
      </p>
      <div class="flex flex-wrap gap-3">
        <.link href={~p"/register"} class="btn btn-primary">Start designing</.link>
        <.link href={~p"/login"} class="btn btn-ghost">Sign in</.link>
      </div>
    </div>

    <div class="rounded-box bg-base-200 p-4">
      <div class="grid grid-cols-8 gap-1">
        <div
          :for={idx <- 0..63}
          class={[
            "aspect-square rounded-sm",
            rem(idx + div(idx, 8), 4) == 0 && "bg-primary",
            rem(idx + div(idx, 8), 4) == 1 && "bg-secondary",
            rem(idx + div(idx, 8), 4) == 2 && "bg-accent",
            rem(idx + div(idx, 8), 4) == 3 && "bg-base-300"
          ]}
        />
      </div>
    </div>
  </section>
</Layouts.app>
