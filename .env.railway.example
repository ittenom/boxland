# Railway service variables for the Boxland web service.
#
# In a Railway template, set DATABASE_URL to reference the Postgres service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

DATABASE_URL=${{Postgres.DATABASE_URL}}
ECTO_IPV6=true
LANG=en_US.UTF-8
LC_CTYPE=en_US.UTF-8
SECRET_KEY_BASE=replace_with_output_of_mix_phx_gen_secret

# Optional. If unset, any valid email can create a designer account.
# If set, designer signup is limited to exact email domains like example.com.
DESIGNER_EMAIL_DOMAIN=

# Optional. If unset, the app uses Railway's RAILWAY_PUBLIC_DOMAIN.
PHX_HOST=
