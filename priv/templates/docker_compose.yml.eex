# Generated by Boxland Install. Do not edit manually — re-running
# Install will overwrite this file. Edit ~/.boxland/config.exs to
# customize ports etc.

services:
  postgres:
    image: postgres:16
    networks:
      - boxland-net
    environment:
      POSTGRES_USER: boxland
      POSTGRES_PASSWORD: boxland
      POSTGRES_DB: boxland
    ports:
      - "5432:5432"
    volumes:
      - <%= @data_dir %>/services/pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U boxland"]
      interval: 5s
      timeout: 3s
      retries: 5

  redis:
    image: redis:7
    networks:
      - boxland-net
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  minio:
    image: minio/minio
    networks:
      - boxland-net
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: boxland
      MINIO_ROOT_PASSWORD: boxland-dev-secret
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - <%= @data_dir %>/services/minio_data:/data

networks:
  boxland-net:
    name: boxland-net
    external: true
